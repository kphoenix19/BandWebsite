---
import '../styles/global.css';
import { band } from '../config';

interface Props { title: string }
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const isGigsPage = currentPath.endsWith('/gigs') || currentPath.endsWith('/gigs/');
const isMusicPage = currentPath.endsWith('/music') || currentPath.endsWith('/music/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`Official site for ${band.name}.`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label={`${band.name} home`}>{band.abbreviation}<span>.</span></a>
      <nav aria-label="Main navigation">
        <a class:list={[{ active: !isGigsPage && !isMusicPage }]} href={base}>Home</a>
        <a class:list={[{ active: isGigsPage }]} href={`${base}/gigs/`}>Gigs</a>
        <a class:list={[{ active: isMusicPage }]} href={`${base}/music/`}>Music</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer container">
      <a class="wordmark" href={base}>{band.abbreviation}<span>.</span></a>
      <p>Copyright 2026 {band.name}. All noise reserved.</p>
      <a href="https://chatgpt.com/" target="_blank" rel="noreferrer">Temporary social link</a>
    </footer>
  </body>
</html>
